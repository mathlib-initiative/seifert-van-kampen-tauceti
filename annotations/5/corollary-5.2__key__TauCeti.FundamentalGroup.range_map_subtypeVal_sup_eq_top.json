          },
          "snippet": {
            "line": 185,
            "text": "theorem range_map_subtypeVal_sup_eq_top {A B : Set X} (hAB : interior A ∪ interior B = univ)\n    (hA : IsPathConnected A) (hB : IsPathConnected B) (hAB' : IsPathConnected (A ∩ B))\n    (hxA : x ∈ A) (hxB : x ∈ B) :\n    ((_root_.FundamentalGroup.map (ContinuousMap.subtypeVal A) ⟨x, hxA⟩).range ⊔\n        (_root_.FundamentalGroup.map (ContinuousMap.subtypeVal B) ⟨x, hxB⟩).range :\n      Subgroup (_root_.FundamentalGroup X x)) = ⊤ := by"
          }
        }
