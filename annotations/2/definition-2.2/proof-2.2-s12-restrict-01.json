          "snippet": {
            "line": 564,
            "text": "private lemma lift_eq_locVal {x y : X} (γ : Path x y) (i : ι) (hγ : ∀ t, γ t ∈ U i) :\n    lift hU F hF γ = locVal hU F hF i γ hγ := by\n  obtain ⟨N₀, hN₀⟩ := exists_isFine hU γ\n  rw [lift_eq_liftN hU F hF γ (hN₀ N₀ le_rfl).2 (hN₀ N₀ le_rfl).1, liftN_eq_locVal]"
