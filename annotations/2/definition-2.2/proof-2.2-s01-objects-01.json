            "text": "private lemma obj_eq (i : ι) {x : X} (hx : x ∈ U i) :\n    (F i).obj (mk ⟨x, hx⟩) = glueObj hU F x :=\n  Functor.congr_obj (hF i (hU x).choose) (mk ⟨x, hx, mem_of_mem_nhds (hU x).choose_spec⟩)"
