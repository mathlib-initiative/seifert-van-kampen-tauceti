          },
          "snippet": {
            "line": 173,
            "text": "theorem FundamentalGroup.map_fromPath {Y : Type*} [TopologicalSpace Y] (f : C(X, Y)) (base : X)\n    (q : Path base base) :\n    _root_.FundamentalGroup.map f base\n        (_root_.FundamentalGroup.fromPath (Path.Homotopic.Quotient.mk q)) =\n      _root_.FundamentalGroup.fromPath (Path.Homotopic.Quotient.mk (q.map f.continuous)) := by"
          }
