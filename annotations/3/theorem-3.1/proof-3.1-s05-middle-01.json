            "text": "  have hmid : (End.of (σa ≫ _root_.FundamentalGroupoid.fromPath ⟦δ⟧ ≫ inv σb) :\n      _root_.FundamentalGroup X x) ∈ H := by\n    rw [← Groupoid.inv_eq_inv]\n    refine fromPath_mem_iSup_range hx (i := i) (hσa.somePath.trans (δ.trans hσb.somePath.symm)) ?_\n    rw [Path.trans_range, Path.trans_range, Path.symm_range]\n    exact union_subset (hσa'.trans inter_subset_right)\n      (union_subset hδ (hσb'.trans inter_subset_left))"
