            "line": 133,
            "text": "  choose i₀ hi₀ using hU\n  have hτ : ∀ y, JoinedIn (U (i₀ y)) x y := fun y ↦\n    ((hpc (i₀ y) (i₀ y)).joinedIn x ⟨hx _, hx _⟩ y\n      ⟨mem_of_mem_nhds (hi₀ y), mem_of_mem_nhds (hi₀ y)⟩).mono inter_subset_left\n  have hτ' : ∀ y, range (hτ y).somePath ⊆ U (i₀ y) := fun y ↦\n    range_subset_iff.2 (hτ y).somePath_mem\n  let τ : ∀ c : _root_.FundamentalGroupoid X, mk x ⟶ c := fun c ↦\n    _root_.FundamentalGroupoid.fromPath ⟦(hτ c.as).somePath⟧"
