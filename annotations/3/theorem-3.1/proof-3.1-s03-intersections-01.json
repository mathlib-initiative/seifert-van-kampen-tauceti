            "text": "  have hσa := (hpc j i).joinedIn x ⟨hx j, hx i⟩ a ⟨hα α.target_mem_range, hδ δ.source_mem_range⟩\n  have hσb := (hpc i k).joinedIn x ⟨hx i, hx k⟩ b ⟨hδ δ.target_mem_range, hβ β.target_mem_range⟩\n  have hσa' : range hσa.somePath ⊆ U j ∩ U i := range_subset_iff.2 hσa.somePath_mem\n  have hσb' : range hσb.somePath ⊆ U i ∩ U k := range_subset_iff.2 hσb.somePath_mem\n  set σa := _root_.FundamentalGroupoid.fromPath ⟦hσa.somePath⟧\n  set σb := _root_.FundamentalGroupoid.fromPath ⟦hσb.somePath⟧"
