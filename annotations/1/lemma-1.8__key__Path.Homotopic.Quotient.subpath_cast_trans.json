          },
          "snippet": {
            "line": 325,
            "text": "theorem subpath_cast_trans {x y : X} (p : Path x y) (a b c : unitInterval) {x₀ x₁ x₂ : X}\n    (h₀ : x₀ = p a) (h₁ : x₁ = p b) (h₂ : x₂ = p c) :\n    trans (mk ((p.subpath a b).cast h₀ h₁)) (mk ((p.subpath b c).cast h₁ h₂)) =\n      mk ((p.subpath a c).cast h₀ h₂) := by"
          }
        }
      }
