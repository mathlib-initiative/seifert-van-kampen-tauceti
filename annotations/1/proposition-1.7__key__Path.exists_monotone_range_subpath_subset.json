          },
          "snippet": {
            "line": 224,
            "text": "theorem exists_monotone_range_subpath_subset {ι : Type*} {U : ι → Set X} {x y : X}\n    (γ : Path x y) (hU : ∀ s, ∃ i, γ ⁻¹' U i ∈ 𝓝 s) :\n    ∃ (n : ℕ) (t : Fin (n + 1) → I), t 0 = 0 ∧ t (Fin.last n) = 1 ∧ Monotone t ∧\n      ∀ k : Fin n, ∃ i, range (γ.subpath (t k.castSucc) (t k.succ)) ⊆ U i := by"
          }
        }
      }
    }
