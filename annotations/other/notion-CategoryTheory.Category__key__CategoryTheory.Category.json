          },
          "snippet": {
            "line": 234,
            "text": "class Category (obj : Type u) : Type max u (v + 1) extends CategoryStruct.{v} obj where\n  /-- Identity morphisms are left identities for composition. -/\n  id_comp : ∀ {X Y : obj} (f : X ⟶ Y), 𝟙 X ≫ f = f := by cat_disch\n  /-- Identity morphisms are right identities for composition. -/\n  comp_id : ∀ {X Y : obj} (f : X ⟶ Y), f ≫ 𝟙 Y = f := by cat_disch\n  /-- Composition in a category is associative. -/\n  assoc : ∀ {W X Y Z : obj} (f : W ⟶ X) (g : X ⟶ Y) (h : Y ⟶ Z), (f ≫ g) ≫ h = f ≫ g ≫ h := by\n    cat_disch"
          }
        }
      }
    }
