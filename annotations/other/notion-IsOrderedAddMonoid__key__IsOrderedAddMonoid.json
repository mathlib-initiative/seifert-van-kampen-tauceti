          },
          "snippet": {
            "line": 27,
            "text": "class IsOrderedAddMonoid (α : Type*) [AddCommMonoid α] [Preorder α] where\n  protected add_le_add_left (a b : α) : a ≤ b → ∀ c, a + c ≤ b + c\n  protected add_le_add_right (a b : α) : a ≤ b → ∀ c, c + a ≤ c + b := fun h c ↦ by\n    rw [add_comm c, add_comm c]; exact add_le_add_left a b h c"
          }
        }
