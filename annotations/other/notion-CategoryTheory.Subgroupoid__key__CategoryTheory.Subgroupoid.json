          },
          "snippet": {
            "line": 72,
            "text": "structure Subgroupoid (C : Type u) [Groupoid C] where\n  /-- The arrow choice for each pair of vertices -/\n  arrows : ∀ c d : C, Set (c ⟶ d)\n  protected inv : ∀ {c d} {p : c ⟶ d}, p ∈ arrows c d → Groupoid.inv p ∈ arrows d c\n  protected mul : ∀ {c d e} {p}, p ∈ arrows c d → ∀ {q}, q ∈ arrows d e → p ≫ q ∈ arrows c e"
          }
        }
      }
