            "line": 74,
            "text": "def codRestrict {s : Set X} {x y : s} (γ : Path x.val y.val) (hmem : ∀ t, γ t ∈ s) :\n    Path x y where\n  toFun := s.codRestrict γ hmem\n  continuous_toFun := γ.continuous.codRestrict hmem\n  source' := Subtype.ext γ.source\n  target' := Subtype.ext γ.target"
