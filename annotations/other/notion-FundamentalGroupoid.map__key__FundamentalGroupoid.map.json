          },
          "snippet": {
            "line": 301,
            "text": "@[simps] def map (f : C(X, Y)) : FundamentalGroupoid X ⥤ FundamentalGroupoid Y where\n  obj x := ⟨f x.as⟩\n  map p := p.map f\n  map_id _ := rfl\n  map_comp := by rintro _ _ _ ⟨p⟩ ⟨q⟩; congrm Quotient.mk'' $(p.map_trans q f.continuous)"
          }
        }
      }
