          },
          "snippet": {
            "line": 40,
            "text": "class Groupoid (obj : Type u) : Type max u (v + 1) extends Category.{v} obj where\n  /-- The inverse morphism -/\n  inv : ∀ {X Y : obj}, (X ⟶ Y) → (Y ⟶ X)\n  /-- `inv f` composed `f` is the identity -/\n  inv_comp : ∀ {X Y : obj} (f : X ⟶ Y), comp (inv f) f = id Y := by cat_disch\n  /-- `f` composed with `inv f` is the identity -/\n  comp_inv : ∀ {X Y : obj} (f : X ⟶ Y), comp f (inv f) = id X := by cat_disch"
          }
        }
      }
    }
