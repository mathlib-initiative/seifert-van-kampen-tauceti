          },
          "snippet": {
            "line": 388,
            "text": "class Monoid (M : Type*) extends One M, Mul M, Semigroup M, MulOneClass M, NPow M where\n  npow := npowRecAuto\n  /-- Raising to the power `(0 : ℕ)` gives `1`. -/\n  protected npow_zero (x : M) : x ^ 0 = 1 := by intros; rfl\n  /-- Raising to the power `(n + 1 : ℕ)` behaves as expected. -/\n  protected npow_succ (n : ℕ) (x : M) : x ^ (n + 1) = x ^ n * x := by intros; rfl"
          }
        }
      }
